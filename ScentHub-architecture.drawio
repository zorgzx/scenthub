<mxfile host="app.diagrams.net"><diagram id="scenthub-arch" name="ScentHub Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="ScentHub: System Architecture (Layered Spring Boot)" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1A150E;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1310" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Example flow: user submits a review → ReviewController → ReviewService (one review per user, recalculate average rating) → ReviewRepository → reviews table in PostgreSQL → updated perfume page" style="text;html=1;fontSize=12;fontColor=#5A4A2A;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1310" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Spring Security: login, BCrypt password hashing, roles USER / MODERATOR / ADMIN. Checks every request before it reaches a Controller." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1A150E;strokeColor=#B8924A;fontColor=#F5EEE2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="470" height="44" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1. Frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Thymeleaf pages, HTML, CSS, JavaScript&lt;br&gt;Login, Register, Home, Catalog, Perfume page, Add review, My profile, Admin panel" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;strokeWidth=2;fontSize=12;fontColor=#1A150E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="150" as="geometry"/></mxCell><mxCell id="c6" value="Responsibility:&lt;br&gt;Shows pages in the browser and sends user actions (forms, clicks) as HTTP requests.&lt;br&gt;&lt;br&gt;Receives ready HTML from the server." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9CBA6;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="190" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2. Controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;AuthController&lt;br&gt;PerfumeController&lt;br&gt;ReviewController&lt;br&gt;ProfileController&lt;br&gt;AdminController" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;strokeWidth=2;fontSize=12;fontColor=#1A150E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="190" height="150" as="geometry"/></mxCell><mxCell id="c8" value="Responsibility:&lt;br&gt;Processes HTTP requests, validates input (@Valid), calls the Service and returns a view or response.&lt;br&gt;&lt;br&gt;Contains no business logic." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9CBA6;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="320" y="318" width="190" height="170" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;3. Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;AuthService&lt;br&gt;PerfumeService (filters, monthly top)&lt;br&gt;ReviewService (average rating)&lt;br&gt;ListService (Favorites, Want to try)&lt;br&gt;ModerationService" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;strokeWidth=2;fontSize=12;fontColor=#1A150E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="190" height="150" as="geometry"/></mxCell><mxCell id="c10" value="Responsibility:&lt;br&gt;Business logic: average ratings, only one review per user per perfume, search by notes, monthly top, moderation rules.&lt;br&gt;&lt;br&gt;Marked @Transactional." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9CBA6;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="318" width="190" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;4. Repository&lt;/b&gt;&lt;br&gt;&lt;br&gt;UserRepository&lt;br&gt;PerfumeRepository&lt;br&gt;ReviewRepository&lt;br&gt;BrandRepository, NoteRepository&lt;br&gt;FavoriteListRepository" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;strokeWidth=2;fontSize=12;fontColor=#1A150E;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="190" height="150" as="geometry"/></mxCell><mxCell id="c12" value="Responsibility:&lt;br&gt;Database access through Spring Data JPA: save, find, delete and custom queries.&lt;br&gt;&lt;br&gt;Works with Entities, never with HTML." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9CBA6;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="880" y="318" width="190" height="170" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;5. Database&lt;/b&gt;&lt;br&gt;&lt;br&gt;PostgreSQL&lt;br&gt;tables: users, perfumes, brands, notes, perfume_notes, reviews, favorite_lists" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E9DDBF;strokeColor=#B8924A;strokeWidth=2;fontSize=12;fontColor=#1A150E;verticalAlign=top;spacingTop=8;shape=cylinder3;boundedLbl=1;size=14;" vertex="1" parent="1"><mxGeometry x="1160" y="150" width="190" height="150" as="geometry"/></mxCell><mxCell id="c14" value="Responsibility:&lt;br&gt;Stores and manages all application data: users, perfumes, reviews and personal lists.&lt;br&gt;&lt;br&gt;Keeps relations and constraints." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9CBA6;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1160" y="318" width="190" height="170" as="geometry"/></mxCell><mxCell id="c15" value="HTTP request / HTML view" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;startArrow=block;startFill=1;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;startArrow=block;startFill=1;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;startArrow=block;startFill=1;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="JPA / SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;startArrow=block;startFill=1;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;dashed=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Entity / Model (JPA @Entity)&lt;/b&gt;: User, Perfume, Brand, Note, Review, FavoriteList — the Service and Repository layers pass these objects between each other" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1A150E;strokeColor=#B8924A;fontColor=#F5EEE2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="506" width="1030" height="40" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;dashed=1;startArrow=none;" edge="1" parent="1" source="c20" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;dashed=1;" edge="1" parent="1" source="c20" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Entity relationships" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1A150E;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="260" height="28" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;User&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;username, email&lt;br&gt;passwordHash&lt;br&gt;role (USER / MODERATOR / ADMIN)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="210" height="120" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Review&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;longevity, sillage, overall (1-5)&lt;br&gt;text&lt;br&gt;status (PENDING / APPROVED)&lt;br&gt;createdAt" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="360" y="610" width="210" height="120" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Perfume&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;name, description&lt;br&gt;category&lt;br&gt;photoUrl&lt;br&gt;brand_id (FK)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="610" width="210" height="120" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Brand&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;name&lt;br&gt;country" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="610" width="210" height="120" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;FavoriteList&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;type (FAVORITE / WANT_TO_TRY)&lt;br&gt;user_id (FK), perfume_id (FK)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="210" height="120" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Note&lt;/b&gt;&lt;hr&gt;id (PK)&lt;br&gt;name&lt;br&gt;type (TOP / HEART / BASE)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FBF6EA;strokeColor=#B8924A;fontSize=12;fontColor=#1A150E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="210" height="120" as="geometry"/></mxCell><mxCell id="c30" value="writes 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;endArrow=none;startArrow=none;strokeWidth=1.5;strokeColor=#5A4A2A;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="about N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;endArrow=none;startArrow=none;strokeWidth=1.5;strokeColor=#5A4A2A;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="has 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;endArrow=none;startArrow=none;strokeWidth=1.5;strokeColor=#5A4A2A;" edge="1" parent="1" source="c27" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="N : M (perfume_notes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;endArrow=none;startArrow=none;strokeWidth=1.5;strokeColor=#5A4A2A;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="owns 1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;endArrow=none;startArrow=none;strokeWidth=1.5;strokeColor=#5A4A2A;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B8924A;fontSize=11;fontColor=#5A4A2A;endArrow=none;startArrow=none;strokeWidth=1.5;strokeColor=#5A4A2A;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="c28" target="c26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="820"/><mxPoint x="340" y="740"/><mxPoint x="743" y="740"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>